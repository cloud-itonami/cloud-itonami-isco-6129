;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a farm-scheduling robot performs feeding-schedule
;; and animal-condition check-in data entry, crew/task scheduling and
;; feed/supplies procurement coordination for animal producers n.e.c.
;; (ISCO 6129). It never handles animals. Its physical work is supply
;; logistics: hauling delivered 25 kg feed sacks across the farmyard to the
;; feed store, and stacking a sack onto the store pallet.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-6129"
 :cases
 [{:id :feed-sacks-to-feed-store
   :kind :transport
   :procedure "logistics robot hauls delivered feed sacks 70 m across the gravel farmyard from the delivery point to the feed store"
   :params {:mass-kg 80.0 :distance-m 70.0 :v-max-mps 0.9 :a-max-mps2 0.3
            :brake-decel-mps2 0.6 :drive-force-n 250.0 :crr 0.04
            :cog-height-m 0.50 :support-half-length-m 0.40}
   :sweep {:param :payload-kg :values [25.0 50.0 100.0 150.0 200.0]}
   :quantity :cycle-time-s
   :limit {:max 150.0 :basis "estimate: a feed delivery of ~1 t must be stored within the driver's 1-hour unloading slot, i.e. ~2.5 min per haul"}
   :boundary {:lo 5.0 :hi 700.0}}
  {:id :feed-sack-onto-pallet
   :kind :manipulator
   :procedure "arm lifts a feed sack from the robot's deck onto the stack on the feed-store pallet"
   :params {:l1-m 0.70 :l2-m 0.60 :m1-kg 10.0 :m2-kg 8.0
            :from [0.80 0.20] :to [0.40 1.00] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [5.0 10.0 15.0 20.0 25.0]}
   :quantity :peak-tau1-nm
   :limit {:max 250.0 :basis "estimate: continuous shoulder torque of a ~25 kg payload class palletising arm"}
   :boundary {:lo 1.0 :hi 60.0}}]}
